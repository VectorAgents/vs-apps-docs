{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vs-apps-docs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "routes": [
    {
      "pattern": "docs.redemptai.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // Without this an asset is served before the Basic auth check in worker/index.ts runs.
    "run_worker_first": true,
    // Docusaurus links to /page and writes page/index.html.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Values are set once with `wrangler secret put <name>` and survive later deploys.
  "secrets": { "required": ["BASIC_AUTH_USER", "BASIC_AUTH_PASSWORD"] },
  "observability": { "enabled": true }
}
